{
  "name": "gitdenn",
  "version": "1.4.0",
  "description": "A desktop Git client built with Electron",
  "main": "src/main/main.js",
  "author": "Morgan Denn",
  "homepage": "https://gitdenn.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morgdenn/gitdenn.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "distMac": "electron-builder --mac"
  },
  "dependencies": {
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.morgdenn.gitdenn",
    "productName": "GitDenn",
    "icon": "public/icon.png",
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "morgdenn",
      "repo": "gitdenn"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    }
  }
}
