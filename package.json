{
  "name": "gitdenn",
  "version": "1.0.0",
  "description": "A desktop Git client built with Electron",
  "main": "src/main/main.js",
  "author": "Morgan Denn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/morgdenn/gitdenn.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.morgdenn.gitdenn",
    "productName": "GitDenn",
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
